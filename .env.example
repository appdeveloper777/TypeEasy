# ==========================================
# Gemini AI Configuration
# ==========================================
# Obtén tu API Key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ==========================================
# WhatsApp Provider Configuration
# ==========================================
# Opciones: waha, meta, twilio, mock
WHATSAPP_PROVIDER=waha

# ==========================================
# WAHA Configuration (si usas WAHA)
# ==========================================
# Genera una clave propia por despliegue (ej. `openssl rand -hex 32`); no
# reutilices el valor de ejemplo, controla el acceso a la sesión de WhatsApp.
WAHA_API_KEY=cambia-esto-por-una-clave-aleatoria-unica
WAHA_API_URL=http://waha:3000
# Secreto compartido para autenticar los webhooks entrantes de WAHA en
# /waha_webhook (WAHA los reenvía en la URL configurada vía WAHA_WEBHOOK_URL).
# Sin esto, cualquiera que alcance el endpoint puede falsificar mensajes de
# WhatsApp entrantes. Genera uno único, ej. `openssl rand -hex 32`.
WAHA_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ==========================================
# Meta WhatsApp Cloud API (si usas Meta)
# ==========================================
# Obtén tus credenciales en: https://developers.facebook.com/apps/
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_APP_SECRET=
# Token de verificación para el webhook (elige uno único)
META_VERIFY_TOKEN=

# ==========================================
# Twilio (opcional, si usas Twilio)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+123456789

# ==========================================
# JWT / Auth Configuration
# ==========================================
# Secret HS256 para firmar (login) y validar (@auth) los JWT.
# Lo leen los .te con env("JWT_SECRET") y el decorador @auth (getenv).
# Genera uno fuerte con:  openssl rand -base64 48
# NO uses este valor de ejemplo en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ==========================================
# Agent Configuration
# ==========================================
# Comunicación interna entre servicios (no cambiar)
AGENT_WEBHOOK=http://agent_gemini:8081/whatsapp_hook

# ==========================================
# Typing Delay (Delay antes de responder)
# ==========================================
# Tiempo en segundos que espera antes de enviar respuesta
# Simula que el bot está "escribiendo..." para conversación más natural
# Valores recomendados: 1.0 (rápido), 2.0 (normal), 3.0 (pausado)
TYPING_DELAY=2.0

# ==========================================
# Debug Mode
# ==========================================
# 1 = activado, 0 = desactivado
TYPEEASY_DEBUG=0

# ==========================================
# NOTA IMPORTANTE
# ==========================================
# NO subas este archivo con credenciales reales a Git
# Usa .env (ignorado por Git) para tus secretos
