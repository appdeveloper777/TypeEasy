class Linea{
cantidad:int;
__constructor(_c:int){this.cantidad=_c;}
Total():int{return this.cantidad*2;}
}
let f=fn(a,b)=>{if(a>b&&b!=0){return a-b;}else{return -a;}};
for(i=0;3;1){total=total+i;// acumula
}
for(var j=10;j>=0;j-=5){total+=j;}
let m={"from":1,"n":total>=0?"pos":"neg"};
let t=total>0?f(total,1):f(1,total);
let s=$"total={total}";
let z=m?.nope??"default";
