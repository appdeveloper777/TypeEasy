// spec: NUM-11
// Float calculado: menor texto round-trip; float integral sin decimales; exponente en extremos.
// Un LITERAL float conserva su texto fuente dentro de json()/listas serializadas (1.50 -> 1.50).
println(0.1 + 0.2);
println("" + 1.0);
println("" + 2.50);
println($"{1/3}");
println("" + 100000000000000000000.0);
println("" + 0.000001);
let l = [1.5, 2.0, 1/4];
println(l);
let a = 1.0;
println(json({ a: a, b: 1.0, c: 1.50, d: 2.0 * 3, e: 0.1 + 0.2 }));
println("s=" + (10 + 20));
