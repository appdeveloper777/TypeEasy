// spec: NUM-3
// int / int: int si es exacta, float si hay resto; division exacta mas alla de 2^53.
println(10 / 5);
println(35 / 20);
println(7 / 2);
println(-7 / 2);
println(1 / 3);
println(9007199254740993 / 3);
println(10.0 / 5);
let t : int = 10 / 5;
println(t);
println(Math.floor(7 / 2));
println(Math.ceil(35 / 20));
println(to_int(7 / 2));
