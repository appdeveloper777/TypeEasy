// spec: JSN-2
// json_parse: true/false llegan como bool (round-trip true/false; en contexto string "1"/"0",
// comparan igual a 1/0); null -> null; numeros con decimales conservan su texto al re-serializar;
// strings numericos se conservan.
let p = json_parse("{\"a\":1,\"b\":[1,2],\"c\":{\"d\":\"x\"},\"e\":true,\"f\":null,\"g\":1.50,\"h\":\"007\"}");
println(p["a"]); println(p["b"]); println(p["b"][1]); println(p["c"]["d"]);
println(p["e"]); println(p["e"] == 1); println("" + p["f"]); println(p["g"]); println(p["h"]);
println(json(p));
println(("" + p["e"]) == "1");
println("" + p["e"]);
let q = json_parse("{\"ok\":false,\"n\":0}");
println(json_stringify(q));
if (q["ok"]) { println("truthy"); } else { println("falsy"); }
if (p["e"] == true) { println("eq_true"); }
