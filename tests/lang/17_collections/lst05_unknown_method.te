// spec: LST-5
// Un metodo inexistente sobre una lista o un map LANZA un TypeError catcheable
// (hasta 0.1.9: aviso en stderr y resultado null, que como falsy escondia el typo).
// max/min/indexOf no existen: usar orderBy/reduce/filter.
let nums = [1, 2, 3];
var r = 7;
try {
  r = nums.max();
  println("no llega");
} catch (e) {
  println("catch:" + e);
}
println("r sigue:" + r);
let m = { a: 1 };
try {
  let z = m.contains("a");
  println("no llega");
} catch (e) {
  println("catch:" + e);
}
// los metodos existentes siguen igual
println("" + nums.sum());
println("" + m.has("a"));
println("sigue");
