// Contrato acelerador bytecode == walker (tests/regress/run_bc_diff.py corre este
// archivo con y sin TYPEEASY_NO_BC=1 y exige la misma salida).
// Cada bloque cubre una divergencia que existia antes de 0.1.1:
//   1) enteros > 2^53 dentro de un bucle compilado (antes pasaban por double)
//   2) lista[i].attr con un item de OTRA clase (antes devolvia 0 en silencio)
//   3) variable que cambia de tipo entre ejecuciones del mismo nodo (guard -> deopt)
//   4) division/modulo por cero dentro de bytecode (mismo mensaje que el walker)
// expect-contains: Error: division by zero.
// expect-contains: 9007199254740993|9007199254740993|30|A2B|1|-1|3|1.5|0|ok

var big = 9007199254740991;
for (i=0; 2; 1) { big = big + 1; }
var s = "" + big;

var big2 = 9007199254740991;
var k = 0;
while (k < 2) { big2 = big2 + 1; k = k + 1; }
s = s + "|" + big2;

class A { x:int; __constructor(_x:int){ this.x = _x; } }
class B { x:int; __constructor(_x:int){ this.x = _x; } }
let xs = [];
xs.push(new A(10)); xs.push(new A(20));
var tot = 0;
for (i=0; 2; 1) { tot = tot + xs[i].x; }
s = s + "|" + tot;
xs.push(new B(70));
var tot2 = 0;
for (i=0; 3; 1) { tot2 = tot2 + xs[i].x; }
s = s + "|" + (tot2 == 100 ? "A2B" : "mismatch");

var v = 1;
var r = 0;
for (i=0; 3; 1) { r = v + 0; }
s = s + "|" + r;
v = -1;
for (i=0; 3; 1) { r = v + 0; }
s = s + "|" + r;

var f = 1;
for (i=0; 2; 1) { f = f + 1; }
s = s + "|" + f;
f = 0.5;
for (i=0; 1; 1) { f = f + 1; }
s = s + "|" + f;

var z = 0;
var q = 5;
for (i=0; 1; 1) { q = q / z; }
s = s + "|" + q;
println(s + "|ok");
