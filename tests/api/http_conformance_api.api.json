{
  "entry": "http_conformance_api.te",
  "health": "/health",
  "env": {
    "TYPEEASY_DEV": "1",
    "TYPEEASY_MAX_BODY": "4096"
  },
  "cases": [
    { "name": "metodo GET + request_path sin query",
      "path": "/api/m?x=1",
      "expect": { "status": 200, "json": { "m": "GET", "path": "/api/m" },
                  "header": { "Content-Type": "application/json" } } },
    { "name": "metodo POST con cuerpo",
      "method": "POST", "path": "/api/m", "body": "hola",
      "expect": { "status": 200, "json": { "m": "POST", "body": "hola" } } },
    { "name": "metodo PUT con cuerpo",
      "method": "PUT", "path": "/api/m", "body": "put-body",
      "expect": { "status": 200, "json": { "m": "PUT", "body": "put-body" } } },
    { "name": "metodo PATCH con cuerpo",
      "method": "PATCH", "path": "/api/m", "body": "patch-body",
      "expect": { "status": 200, "json": { "m": "PATCH", "body": "patch-body" } } },
    { "name": "metodo DELETE",
      "method": "DELETE", "path": "/api/m",
      "expect": { "status": 200, "json": { "m": "DELETE" } } },
    { "name": "ruta inexistente -> 404",
      "path": "/api/no-existe",
      "expect": { "status": 404 } },
    { "name": "verbo no registrado en una ruta existente -> 405 + Allow",
      "xfail": "el motor responde 404 (find_route no distingue ruta vs verbo). Issue TE #9: 405 Method Not Allowed",
      "method": "DELETE", "path": "/api/h",
      "expect": { "status": 405, "header": { "Allow": "GET" } } },
    { "name": "OPTIONS preflight CORS -> 204 con metodos permitidos",
      "method": "OPTIONS", "path": "/api/m",
      "headers": { "Origin": "http://ejemplo.test", "Access-Control-Request-Method": "PATCH" },
      "expect": { "status": 204,
                  "header": { "Access-Control-Allow-Methods": "PATCH", "Access-Control-Allow-Origin": "" } } },
    { "name": "respuesta normal lleva Access-Control-Allow-Origin",
      "path": "/api/m",
      "expect": { "status": 200, "header": { "Access-Control-Allow-Origin": "" } } },

    { "name": "status 201 Created",
      "path": "/api/status/201",
      "expect": { "status": 201, "reason": "Created", "json": { "code": 201 } } },
    { "name": "status 204 sin cuerpo ni Content-Length",
      "path": "/api/status/204",
      "expect": { "status": 204, "reason": "No Content", "header_absent": ["Content-Length"] } },
    { "name": "status 400 Bad Request",
      "path": "/api/status/400",
      "expect": { "status": 400, "reason": "Bad Request", "json": { "code": 400 } } },
    { "name": "status 409 Conflict (antes salia '409 OK')",
      "path": "/api/status/409",
      "expect": { "status": 409, "reason": "Conflict", "json": { "code": 409 } } },
    { "name": "status 429 Too Many Requests (antes salia '429 OK')",
      "path": "/api/status/429",
      "expect": { "status": 429, "reason": "Too Many Requests" } },
    { "name": "status 503 Service Unavailable",
      "path": "/api/status/503",
      "expect": { "status": 503, "reason": "Service Unavailable" } },
    { "name": "status no listado usa reason generica",
      "path": "/api/status/418",
      "expect": { "status": 418, "reason": "Client Error" } },

    { "name": "request_header no distingue mayusculas; ausente = vacio",
      "path": "/api/h", "headers": { "X-Custom": "valor 1" },
      "expect": { "status": 200, "json": { "a": "valor 1", "b": "valor 1", "falta": "" } } },
    { "name": "response_header personalizado",
      "path": "/api/h/echo?v=hola",
      "expect": { "status": 200, "header": { "X-Echo": "hola" } } },
    { "name": "CR/LF codificado en el URI se rechaza con 400 (civetweb)",
      "path": "/api/h/echo?v=a%0D%0AX-Injected:%201",
      "expect": { "status": 400, "header_absent": ["X-Injected"] } },
    { "name": "response_header no permite inyectar cabeceras (valor con CRLF desde el body)",
      "method": "POST", "path": "/api/h/echo", "body": "a\r\nX-Injected: 1",
      "expect": { "status": 200, "header": { "X-Echo": "aX-Injected: 1" }, "header_absent": ["X-Injected"] } },

    { "name": "cookies multiples, valor con '=' y cookie ausente",
      "path": "/api/c", "headers": { "Cookie": "a=1; b=dos;tok=abc==" },
      "expect": { "status": 200, "json": { "a": "1", "b": "dos", "tok": "abc==", "falta": "" } } },
    { "name": "sin header Cookie todo vacio",
      "path": "/api/c",
      "expect": { "status": 200, "json": { "a": "", "tok": "", "falta": "" } } },
    { "name": "cookie larga (3000 bytes) llega entera",
      "path": "/api/c", "headers": { "Cookie": "a=1; tok={{repeat:k:3000}}" },
      "expect": { "status": 200, "json": { "a": "1", "tok_len": 3000 } } },
    { "name": "varios Set-Cookie en la misma respuesta",
      "path": "/api/c/set",
      "expect": { "status": 200, "header": { "Set-Cookie": "s1=uno" }, "contains": "true" } },
    { "name": "el segundo Set-Cookie tambien sale",
      "path": "/api/c/set",
      "expect": { "status": 200, "header": { "Set-Cookie": "s2=dos" } } },

    { "name": "query: clave repetida -> gana la ultima",
      "path": "/api/q?v=1&v=2",
      "expect": { "status": 200, "json": { "v": "2" } } },
    { "name": "query: valor vacio",
      "path": "/api/q?v=",
      "expect": { "status": 200, "json": { "v": "", "len": 0 } } },
    { "name": "query: valor largo (3000 bytes) llega entero (antes >1023 se descartaba)",
      "path": "/api/q?v={{repeat:z:3000}}",
      "expect": { "status": 200, "json": { "len": 3000 } } },
    { "name": "query: UTF-8 decodificado cuenta bytes",
      "path": "/api/q?v=%C3%B1and%C3%BA",
      "expect": { "status": 200, "json": { "v": "ñandú", "len": 7 } } },

    { "name": "cuerpo UTF-8 crudo ida y vuelta",
      "method": "POST", "path": "/api/echo", "body": "ñandú €",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "expect": { "status": 200, "json": { "body": "ñandú €", "len": 11, "ct": "text/plain; charset=utf-8" } } },
    { "name": "JSON con UTF-8 crudo",
      "method": "POST", "path": "/api/json", "body": "{\"nombre\":\"José\"}",
      "headers": { "Content-Type": "application/json" },
      "expect": { "status": 200, "json": { "nombre": "José" } } },
    { "name": "JSON con escape \\u00e9 (como lo manda JSON.stringify ascii)",
      "method": "POST", "path": "/api/json", "body": { "nombre": "José" },
      "expect": { "status": 200, "json": { "nombre": "José" } } },
    { "name": "cuerpo dentro del limite (TYPEEASY_MAX_BODY=4096)",
      "method": "POST", "path": "/api/echo", "body": "{{repeat:b:4000}}",
      "expect": { "status": 200, "json": { "len": 4000 } } },
    { "name": "cuerpo sobre el limite -> 413 JSON",
      "method": "POST", "path": "/api/echo", "body": "{{repeat:b:5000}}",
      "expect": { "status": 413, "json": { "error": "payload_too_large" } } },
    { "name": "el servidor sigue sano despues del 413",
      "path": "/health",
      "expect": { "status": 200, "json": { "ok": true } } }
  ]
}
