// Regression (TE issue #11, fixed in 0.1.12): `.length` on a parenthesized
// string expression resolves correctly in API mode. Before the fix,
// `(""+row["name"]).length` emitted "is not a valid object to access an
// attribute" and the length guard never triggered (te_ev_access_attr handled
// only list/map/string-var/string-literal receivers, not a general expression).
let ValidateExpressionName = fn(raw) => {
    let p=json_parse(raw);
    let rows=p["rows"];
    for(let row in rows){
        if((""+row["name"]).length>4){response_status(400);return "too_long";}
    }
    return "valid";
};
endpoint {
    [HttpGet("/health")]
    async Health(){return json({ok:true});}
    [HttpPost("/validate")]
    async Validate(){let raw=request_body();let result=ValidateExpressionName(raw);return json({result:result});}
}
