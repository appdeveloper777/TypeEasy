{
  "entry": "security_api.te",
  "health": "/health",
  "env": {
    "TYPEEASY_DEV": "1"
  },
  "cases": [
    {
      "name": "health",
      "path": "/health",
      "expect": {
        "status": 200,
        "json": {
          "ok": true
        }
      }
    },
    {
      "name": "CWE-113: CRLF en valor de response_header no parte la respuesta",
      "path": "/api/hdr",
      "expect": {
        "status": 200,
        "json": {
          "ok": true
        },
        "header": {
          "X-Test": "abcX-Injected: evil"
        },
        "header_absent": [
          "X-Injected",
          "X-Inj2"
        ]
      },
      "method": "POST",
      "body": {
        "v": "abc\r\nX-Injected: evil"
      }
    },
    {
      "name": "CWE-113: CRLF en el NOMBRE del header tampoco inyecta",
      "path": "/api/hdr",
      "expect": {
        "status": 200,
        "header": {
          "X-NombreX-Inj2": "evil: z"
        },
        "header_absent": [
          "X-Inj2"
        ]
      },
      "method": "POST",
      "body": {
        "v": "1"
      }
    },
    {
      "name": "request_cookie de 3000 chars no se trunca a 1 KB",
      "path": "/api/cookie",
      "headers": {
        "Cookie": "a=1; ; z=2"
      },
      "expect": {
        "status": 200,
        "json": {
          "len": 3000
        }
      }
    },
    {
      "name": "request_headers() sigue siendo JSON valido con un header de 9 KB (se descarta el par, no se corta a medias)",
      "path": "/api/hdrs",
      "headers": {
        "X-Long": "",
        "X-Short": "ok"
      },
      "expect": {
        "status": 200,
        "json": {}
      }
    },
    {
      "name": "request_headers() normal incluye headers cortos",
      "path": "/api/hdrs",
      "headers": {
        "X-Short": "ok"
      },
      "expect": {
        "status": 200,
        "json": {
          "X-Short": "ok"
        }
      }
    },
    {
      "name": "el server sigue vivo",
      "path": "/health",
      "expect": {
        "status": 200
      }
    }
  ]
}
